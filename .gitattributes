# Normalize text files to LF in the repository; check out with native endings.
* text=auto

# Windows scripts must keep CRLF so Windows PowerShell 5.1 parses them reliably.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# Binary assets — never diff or convert.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.ico    binary
*.icns   binary
*.bmp    binary
*.woff2  binary
*.zip    binary
*.exe    binary
*.msi    binary
*.dll    binary

# Generated lockfiles: keep them in the repo but out of language stats/diffs.
bun.lock              linguist-generated=true
package-lock.json     linguist-generated=true
src-tauri/Cargo.lock  linguist-generated=true

# Upstream marketing images kept for attribution; not part of the application.
docs/screenshots/*.png linguist-documentation
docs/screenshots/*.webp linguist-documentation
